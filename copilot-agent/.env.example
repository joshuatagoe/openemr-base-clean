# Copy to .env for local runs (.env is git-ignored). Placeholders only; never commit real values.

# Service (prefix COPILOT_, see app/settings.py ServiceSettings)
COPILOT_ENVIRONMENT=development
COPILOT_LOG_LEVEL=info
# Shared secret with the OpenEMR module (same value as the module's COPILOT_TICKET_SECRET).
# Required for POST /v1/bundles and the ticket-gated routes; at least 32 characters. Never commit a real value.
COPILOT_TICKET_SECRET=
# Bundle lifetime in the in-memory store (seconds; default 900 = 15 minutes)
COPILOT_BUNDLE_TTL_SECONDS=900
# Accepted clock skew for signed bundle posts (seconds)
COPILOT_SIGNATURE_MAX_SKEW_SECONDS=300
# Hard timeout for one briefing before a `degraded` event is streamed (seconds)
COPILOT_BRIEFING_TIMEOUT_SECONDS=10
# Browser origin of the OpenEMR panel, e.g. http://localhost:8300 (enables CORS for that origin only)
COPILOT_ALLOWED_ORIGIN=

# Model provider (see app/settings.py; names per ARCHITECTURE.md section 14)
# Required only when the real Anthropic provider is constructed; unit tests and app import do not need it.
ANTHROPIC_API_KEY=
MODEL_PROVIDER=anthropic
MODEL_ID_EXTRACTION=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=20
EXTRACTION_MAX_OUTPUT_TOKENS=2048
EXTRACTION_EFFORT=low

# Optional live integration test (off by default; makes exactly one request with synthetic text)
# RUN_ANTHROPIC_INTEGRATION_TEST=1
