# Copy to dashboard/.env for `npm run dev` (the BFF loads it; .env is git-ignored).
# Never commit real values. Synthetic / dev values only.

# OpenEMR origin (no trailing slash). https required except for localhost.
OPENEMR_BASE_URL=https://localhost:9300
# OIDC issuer = OpenEMR's site_addr_oath + /oauth2/<site>. Must match the id_token `iss` exactly.
OAUTH_ISSUER=https://localhost:9300/oauth2/default
# Confidential client registered for the BFF (see README "Register the OAuth client").
CLIENT_ID=
CLIENT_SECRET=
# Must equal a registered redirect URI exactly. Its path becomes the BFF callback route.
REDIRECT_URI=http://localhost:5173/auth/callback
# At least 32 random characters; signs the session and login cookies.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# true (default) = Secure + __Host- cookies, HSTS. Set false only for plain-http local dev.
COOKIE_SECURE=false

# Optional
# PORT=3000
# HOST=127.0.0.1
# OPENEMR_SITE=default
# UPSTREAM_TIMEOUT_MS=10000
# LOG_LEVEL=info
# WEB_DIST_DIR=../web/dist
# OAUTH_SCOPES=   (defaults to the read-only list in bff/src/config.ts; offline_access is refused)
# The dev stack's self-signed certificate: set NODE_EXTRA_CA_CERTS in the shell
# (not in this file) to point Node at it, instead of disabling TLS checks. See README.
